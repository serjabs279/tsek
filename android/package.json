{
  "name": "tsek-android",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json && node ../node_modules/vite/bin/vite.js build",
    "preview": "node ../node_modules/vite/bin/vite.js preview",
    "tauri": "node ../node_modules/@tauri-apps/cli/tauri.js",
    "android:dev": "node ../node_modules/@tauri-apps/cli/tauri.js android dev",
    "android:apk": "node ../node_modules/@tauri-apps/cli/tauri.js android build --target aarch64 --apk --debug"
  }
}
